[Unit]
Description=Event Radar - ASU Career Services discovery (run_asu_career_discovery.py)

[Service]
Type=oneshot
WorkingDirectory=/home/kanukuntla-r/workspace/event-radar
# See event-radar-hackathons.service for why this shares one flock with
# the other three maintenance services.
ExecStart=/usr/bin/flock -n %t/event-radar-maintenance.lock /home/kanukuntla-r/workspace/event-radar/.venv/bin/python /home/kanukuntla-r/workspace/event-radar/run_asu_career_discovery.py
